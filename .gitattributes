# Set default behavior, normalize all text files to LF
* text=auto eol=lf

# Python
*.py text eol=lf
*.pyw text eol=lf

# Shell
*.sh text eol=lf

# Windows batch
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# JavaScript / TypeScript
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Styles and markup
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.env* text eol=lf
*.sql text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
